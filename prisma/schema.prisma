// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// Auth & User Profile (NextAuth Required Models)
// ────────────────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // TaxRocket Specific Profile Fields
  cnic             String?           @unique
  ntn              String?           @unique
  phone            String?
  dateOfBirth      DateTime?
  address          String?
  city             String?
  defaultTaxYear   Int?
  accounts         Account[]
  sessions         Session[]
  filings          FilingDraft[]
  documents        Document[]
  bankTransactions BankTransaction[]
  ledgerEntries    LedgerEntry[]
  filingPackets    FilingPacket[]
  fbrConnections   FbrConnection[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────
// Filing Journey Models
// ────────────────────────────────────────────────────────────────
model FilingDraft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taxYear           Int
  status            String  @default("IN_PROGRESS")
  currentStep       Int     @default(0)
  filerType         String?
  businessStructure String?

  // SQLite doesn't support arrays, so we store stringified JSON
  incomeSources    String  @default("[]")
  salaryPercentage String?

  // SQLite doesn't support arrays, so we store stringified JSON
  readinessChecks      String            @default("[]")
  openingWealth        Float?
  closingWealth        Float?
  taxPayable           Float?
  refundDue            Float?
  reconciliationGap    Float?
  reconciliationStatus String            @default("UNRESOLVED")
  reconciliationMethod String?
  reconciliationNote   String?
  documents            Document[]
  bankTransactions     BankTransaction[]
  ledgerEntries        LedgerEntry[]
  filingPackets        FilingPacket[]
  fbrConnections       FbrConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, taxYear])
}

model Document {
  id            String       @id @default(cuid())
  filingDraftId String?
  filingDraft   FilingDraft? @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType String
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int

  extractionStatus String   @default("PENDING")
  createdAt        DateTime @default(now())
}

model BankTransaction {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionDate  DateTime?
  description      String
  debit            Float?
  credit           Float?
  balance          Float?
  source           String    @default("MANUAL")
  sourceDocumentId String?

  classificationStatus String  @default("UNREVIEWED")
  suggestedEntryType   String?
  suggestedCategory    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filingDraftId])
  @@index([userId])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  entryDate           DateTime?
  entryType           String
  category            String?
  description         String
  amount              Float
  source              String    @default("MANUAL")
  sourceDocumentId    String?
  sourceTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filingDraftId])
  @@index([userId])
  @@index([entryType])
}

model FilingPacket {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  version          Int
  packetHash       String
  snapshotJson     String
  status           String    @default("GENERATED")
  approvalStatus   String    @default("PENDING")
  approvedAt       DateTime?
  approvedByUserId String?
  fileUrl          String?
  taxPayable       Float     @default(0)
  refundDue        Float     @default(0)
  createdAt        DateTime  @default(now())

  @@unique([filingDraftId, version])
  @@index([userId])
}

model FbrConnection {
  id            String      @id @default(cuid())
  filingDraftId String      @unique
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        String    @default("NOT_STARTED")
  agentId       String?
  message       String?
  errorMessage  String?
  lastHeartbeat DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}
