// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// Auth & User Profile (NextAuth Required Models)
// ────────────────────────────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // TaxRocket Specific Profile Fields
  cnic          String?   @unique
  ntn           String?   @unique
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  city          String?
  defaultTaxYear           Int?
  notificationPreferences  String  @default("{}")
  practicePreferences      String  @default("{}")
  twoFactorEnabled         Boolean @default(false)
  accounts                 Account[]
  sessions      Session[]
  filings          FilingDraft[]
  documents        Document[]
  bankStatements   BankStatement[]
  bankTransactions BankTransaction[]
  ledgerEntries    LedgerEntry[]
  filingPackets    FilingPacket[]
  fbrConnections   FbrConnection[]
  notifications    Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────
// Filing Journey Models
// ────────────────────────────────────────────────────────────────
model FilingDraft {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  taxYear           Int
  status            String    @default("IN_PROGRESS")
  currentStep       Int       @default(0)
  filerType         String?
  businessStructure String?

  // SQLite doesn't support arrays, so we store stringified JSON
  incomeSources     String    @default("[]")
  salaryPercentage  String?

  // SQLite doesn't support arrays, so we store stringified JSON
  readinessChecks   String    @default("[]")
  openingWealth     Float?
  closingWealth     Float?
  taxableIncome     Float?
  taxWithheld       Float?
  taxPayable        Float?
  refundDue         Float?
  taxCalculationStatus String @default("NOT_CALCULATED")
  packetApprovalConfirmed Boolean @default(false)
  packetApprovalAt DateTime?
  packetApprovalByUserId String?
  reconciliationGap    Float?
  reconciliationStatus String    @default("UNRESOLVED")
  reconciliationMethod String?
  reconciliationNote   String?
  documents         Document[]
  bankStatements    BankStatement[]
  bankTransactions  BankTransaction[]
  ledgerEntries     LedgerEntry[]
  filingPackets     FilingPacket[]
  fbrConnections    FbrConnection[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@unique([userId, taxYear])
}

model Document {
  id              String       @id @default(cuid())
  filingDraftId   String?
  filingDraft     FilingDraft? @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType    String
  fileName        String
  fileUrl         String
  mimeType        String
  sizeBytes       Int

  extractionStatus   String      @default("PENDING")
  extractionProvider String?
  extractedData      String?
  extractionError    String?
  extractedAt        DateTime?
  createdAt          DateTime     @default(now())
}

model BankStatement {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountLabel       String
  accountNumberMasked String?
  currency           String    @default("PKR")
  periodStart        DateTime?
  periodEnd          DateTime?
  openingBalance     Float
  closingBalance     Float
  sourceDocumentId   String?

  transactions BankTransaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([filingDraftId])
  @@index([userId])
}

model BankTransaction {
  id              String         @id @default(cuid())
  filingDraftId   String
  filingDraft     FilingDraft   @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  bankStatementId String?
  bankStatement   BankStatement? @relation(fields: [bankStatementId], references: [id], onDelete: SetNull)
  userId          String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionDate  DateTime?
  description      String
  debit            Float?
  credit           Float?
  balance          Float?
  source           String    @default("MANUAL")
  sourceDocumentId String?

  classificationStatus String  @default("UNREVIEWED")
  suggestedEntryType  String?
  suggestedCategory   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filingDraftId])
  @@index([userId])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  entryDate       DateTime?
  entryType       String
  category        String?
  description     String
  amount          Float
  source          String      @default("MANUAL")
  sourceDocumentId String?
  sourceTransactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filingDraftId])
  @@index([userId])
  @@index([entryType])
}

model FilingPacket {
  id            String      @id @default(cuid())
  filingDraftId String
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  version          Int
  packetHash       String
  snapshotJson     String
  status           String   @default("GENERATED")
  approvalStatus   String   @default("PENDING")
  approvedAt       DateTime?
  approvedByUserId String?
  fileUrl          String?
  taxPayable       Float    @default(0)
  refundDue        Float    @default(0)
  createdAt        DateTime @default(now())

  @@unique([filingDraftId, version])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("GENERAL")
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model FbrConnection {
  id            String      @id @default(cuid())
  filingDraftId String      @unique
  filingDraft   FilingDraft @relation(fields: [filingDraftId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          String    @default("NOT_STARTED")
  agentId         String?
  message         String?
  errorMessage    String?
  lastHeartbeat   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}
